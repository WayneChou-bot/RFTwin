{
  "$defs": {
    "ControlState": {
      "additionalProperties": false,
      "description": "§51 模擬控制狀態（後端權威；多分頁一致）。§52：seq 單調遞增，前端拒收倒退的控制狀態。",
      "properties": {
        "paused": {
          "title": "Paused",
          "type": "boolean"
        },
        "speed": {
          "exclusiveMinimum": 0,
          "title": "Speed",
          "type": "number"
        },
        "seq": {
          "default": 0,
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        }
      },
      "required": [
        "paused",
        "speed"
      ],
      "title": "ControlState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "§51 控制變更廣播（暫停／播放／倍速／Reset 後）：所有分頁以此同步。無 seq。",
  "properties": {
    "type": {
      "const": "control",
      "title": "Type",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "sim_tick": {
      "minimum": 0,
      "title": "Sim Tick",
      "type": "integer"
    },
    "control": {
      "$ref": "#/$defs/ControlState"
    }
  },
  "required": [
    "type",
    "schema_version",
    "run_id",
    "sim_tick",
    "control"
  ],
  "title": "ControlMessage",
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#"
}
